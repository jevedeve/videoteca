
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pelicula {
  id          String   @id @default(cuid())
  titulo      String
  tipo        String @default("pelicula")
  comentario  String?
  vista       Boolean  @default(false)
  guardadaEn  DateTime @default(now())
  tmdbId      Int?
  poster      String?
  sinopsis    String?
  valoracion  Int?
  @@unique([tipo, tmdbId])
}
